# ============================================================================
# leadScaler — Environment Configuration Template
# Copy to /opt/n8n/.env (and restart n8n + backend services)
# ============================================================================

# --- Stage 04: 6-Stage Sequential Free B2B Lead API Waterfall ---
PROSPEO_API_KEY_1=your_prospeo_account_1_api_key
PROSPEO_API_KEY_2=your_prospeo_account_2_api_key
CLAY_API_KEY_1=your_clay_account_1_scoped_api_key
CLAY_API_KEY_2=your_clay_account_2_scoped_api_key
HUNTER_API_KEY=your_hunter_io_api_key
APOLLO_API_KEY=your_apollo_io_master_api_key

# --- Track A & Stage 07: TinyFish Web & LinkedIn Discovery API ---
TINYFISH_KEY=your_tinyfish_api_key
TINYFISH_SEARCH=https://api.search.tinyfish.ai
TINYFISH_FETCH=https://api.fetch.tinyfish.ai

# --- Stage 08: Primary & Backup LLM Outreach Personalization ---
LLM2_BASE=https://api.xkiro.com/v1
LLM2_KEY=your_xkiro_api_key
LLM2_MODEL=qwen/qwen3.7-flash:free
GEMINI_API_KEY=your_optional_backup_gemini_api_key

# --- Web Workspace & Coordinator Endpoints ---
N8N_BASE_URL=http://127.0.0.1:5678
RACE_SERVICE_URL=http://172.18.0.1:8097
PORT=8095
